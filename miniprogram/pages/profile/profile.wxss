.profile-container {
  padding: 20rpx;
  background: #f8f8f8;
  min-height: 100vh;
}

/* 用户信息区域 */
.user-info {
  display: flex;
  position: relative;
  margin-bottom: 20rpx;
}

.avatar-wrapper {
  padding: 0;
  width: 100rpx !important;
  height: 100rpx !important;
  margin: 0;
  background: none;
  border: none;
  line-height: normal;
}

.avatar-wrapper::after {
  border: none;  /* 移除按钮点击时的边框 */
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  display: block;
}

.user-detail {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100rpx;
  padding: 4rpx 0;
}

.nickname {
  font-size: 34rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 0;
  margin-left: 10px;
}

.level-tag {
  background: #FFE4B5;
  color: #CD853F;
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  display: inline-block;
  align-self: flex-start;
  margin-left: 10px;
}

/* 数据卡片区域 */
.data-cards {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
}

.card-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.card-title::before {
  content: '';
  width: 6rpx;
  height: 30rpx;
  background: #1296DB;
  margin-right: 10rpx;
  border-radius: 3rpx;
}

.card-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 运动记录卡片 */
.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.label {
  font-size: 26rpx;
  color: #666;
}

.value {
  display: flex;
  align-items: baseline;
}

.number {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-right: 8rpx;
}

.unit {
  font-size: 24rpx;
  color: #999;
}

/* 奖章卡片 */
.medal-card .card-content {
  flex-direction: row;
  align-items: center;
}

.medal-icon {
  width: 60rpx;
  height: 60rpx;
  margin-right: 16rpx;
}

.medal-count {
  font-size: 26rpx;
  color: #666;
}

/* 功能图标区域 */
.feature-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  margin-bottom: 30rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.feature-icon {
  width: 80rpx;
  height: 80rpx;
}

.feature-text {
  font-size: 24rpx;
  color: #333;
}

/* 设置菜单 */
.settings-menu {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 20rpx;
  margin-bottom: 30rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 退出登录按钮 */
.logout {
  margin-top: 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.logout .menu-icon {
  display: none;
}

.logout-text {
  flex: none;
  font-size: 28rpx;
  color: #333;
} 