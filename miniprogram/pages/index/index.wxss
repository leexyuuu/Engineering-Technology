.container {
  padding: 15px;
  box-sizing: border-box;
  width: 100vw;
  background: #f8f8f8;
}

.step-card {
  background: linear-gradient(180deg, #1296DB 0%, #0C77B0 100%);
  border-radius: 16px;
  padding: 20px;
  color: white;
  width: 100%;
  box-sizing: border-box;
  min-height: 240px;
  position: relative;
  overflow: hidden;
}

/* 蓝色背景层 */
.step-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, #1296DB 0%, #0C77B0 100%);
  border-radius: 16px;
  z-index: 1;
  transition: opacity 2.8s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 橙色背景层（达标时显示） - 水滴波纹效果 */
.step-card::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, #FF9500 0%, #FF7A00 100%);
  border-radius: 50%;
  z-index: 1;
  opacity: 0;
  transform: translate(-50%, -50%) scale(0);
  transform-origin: center center;
  transition: transform 2.8s cubic-bezier(0.34, 1.56, 0.64, 1),
              border-radius 2.8s cubic-bezier(0.34, 1.56, 0.64, 1),
              opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1) 0.2s;
}

/* 内容层 */
.step-card .card-header,
.step-card .step-content {
  position: relative;
  z-index: 2;
}

/* 达标后显示橙色背景 - 水滴波纹扩散动画 */
.step-card.achieved::after {
  opacity: 1;
  border-radius: 16px;
  transform: translate(-50%, -50%) scale(2.5);
}

/* 达标后隐藏蓝色背景 */
.step-card.achieved::before {
  opacity: 0;
}

/* 滴墨扩散动画 */
@keyframes inkSpread {
  0% {
    width: 0;
    height: 0;
    opacity: 0;
  }
  20% {
    width: 50px;
    height: 50px;
    opacity: 0.8;
  }
  50% {
    width: 200px;
    height: 200px;
    opacity: 0.9;
  }
  80% {
    width: 400px;
    height: 400px;
    opacity: 0.95;
  }
  100% {
    width: 500px;
    height: 500px;
    opacity: 1;
  }
}

.card-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30px;
}

.header-left {
  display: flex;
  align-items: center;
}

.step-icon {
  width: 40px;
  height: 40px;
  margin-right: 12px;
  border-radius: 50%;
  overflow: hidden;
}

.header-text {
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 18px;
  font-weight: 500;
  margin-bottom: 4px;
}

.subtitle {
  font-size: 12px;
  opacity: 0.8;
}

.step-content {
  text-align: center;
}

.step-number {
  margin-bottom: 20px;
}

.step-number .number {
  font-size: 48px;
  font-weight: bold;
}

.step-number .unit {
  font-size: 16px;
  margin-left: 8px;
  opacity: 0.8;
}

.step-details {
  display: flex;
  justify-content: space-between;
  margin-top: 30px;
  padding: 0 20px;
  position: relative;
}

.step-details::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 1px;
  height: 40px;
  background: rgba(255, 255, 255, 0.2);
}

.detail-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.detail-item .label {
  font-size: 14px;
  opacity: 0.8;
  margin-bottom: 8px;
}

.detail-item .value {
  display: flex;
  align-items: baseline;
}

.detail-item .value .number {
  font-size: 24px;
  font-weight: 500;
  margin-right: 4px;
}

.detail-item .value .unit {
  font-size: 12px;
  opacity: 0.8;
}

/* 步数详情部分 */
.step-details-section {
  margin-top: 20px;
  background: #fff;
  border-radius: 12px;
  padding: 20px;
  width: 100%;
  box-sizing: border-box;
}

.details-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20px;
  width: 100%;
}

.detail-box {
  flex: 1;
}

.detail-box:nth-child(2) {
  text-align: left;
  padding-left: 20px;
}

.detail-box:nth-child(2) .detail-value {
  justify-content: flex-start;
}

.detail-box:nth-child(2) .detail-title {
  text-align: left;
}

.detail-title {
  font-size: 14px;
  color: #666;
  margin-bottom: 8px;
  display: block;
}

.detail-value {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
}

.detail-value .number {
  font-size: 28px;
  font-weight: bold;
  color: #333;
  margin-right: 4px;
  min-width: 0;
  flex-shrink: 1;
}

.detail-value .unit {
  font-size: 12px;
  color: #666;
  white-space: nowrap;
}

/* 达标天数高亮样式 - 确保天数和单位都是 #FF9500 */
.detail-value .number.achieved-number {
  color: #FF9500 !important;
}

.detail-value .unit.achieved-unit {
  color: #FF9500 !important;
}

.date-section {
  margin-bottom: 15px;
}

.date {
  font-size: 16px;
  color: #333;
  margin-right: 10px;
}

.weekday {
  font-size: 14px;
  color: #666;
}

.daily-record {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  border-radius: 12rpx;
}

.record-left, .record-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.walk-icon, .distance-icon {
  width: 32rpx;
  height: 32rpx;
}

.steps, .distance {
  font-size: 28rpx;
  color: #333;
}

/* 新增日记录卡片样式 */
.daily-record-section {
  margin-top: 20px;
  background: #fff;
  border-radius: 12px;
  padding: 20px;
  width: 100%;
  box-sizing: border-box;
}

.record-list {
  width: 100%;
}

.record-item {
  padding-bottom: 20px;
  margin-bottom: 20px;
  border-bottom: 1px solid #eee;
}

.record-item:last-child {
  padding-bottom: 0;
  margin-bottom: 0;
  border-bottom: none;
}

.progress-container {
  position: relative;
  width: 240px;
  height: 120px;
  margin: 0 auto;
  margin-bottom: 40px;
  overflow: hidden;
}

/* 背景半圆 */
.semi-circle-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 120px;  /* 只显示上半部分 */
  border-top-left-radius: 120px;  /* 半圆效果 */
  border-top-right-radius: 120px;
  border: 6px solid rgba(255, 255, 255, 0.15);
  border-bottom: none;
  box-sizing: border-box;
  z-index: 1;
}

/* 进度半圆 */
.semi-circle-progress {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 120px;  /* 只显示上半部分 */
  border-top-left-radius: 120px;  /* 半圆效果 */
  border-top-right-radius: 120px;
  border: 6px solid #fff;
  border-bottom: none;
  box-sizing: border-box;
  transform-origin: center bottom;  /* 从底部中心旋转 */
  transform: rotate(0deg);  /* 初始角度 */
  transition: transform 0.3s ease;
  z-index: 2;
}


/* 步数显示 */
.step-number {
  position: absolute;
  top: 55%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  z-index: 3;
}

.step-number .number {
  font-size: 36px;
  font-weight: bold;
  display: block;
  margin-bottom: 4px;
}


.step-number .unit {
  font-size: 12px;
  opacity: 0.8;
}

.calories-icon {
  width: 20px;
  height: 20px;
  margin-right: 4px;
  flex-shrink: 0;
}

/* 同步状态指示器样式 */
.sync-indicator {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sync-loading {
  display: flex;
  align-items: center;
  font-size: 12px;
  color: #FF8C00;
  background: rgba(255, 140, 0, 0.15);
  padding: 4px 8px;
  border-radius: 12px;
  font-weight: 500;
}

/* 达标后（橙色背景）同步状态改为灰色，简洁现代 */
.step-card.achieved .sync-loading {
  color: #333333;
  background: rgba(51, 51, 51, 0.15);
}

.sync-text {
  margin-right: 2px;
}

.dot {
  display: inline-block;
  font-size: 16px;
  line-height: 1;
  animation: wave 1.4s ease-in-out infinite;
}

.dot1 {
  animation-delay: 0s;
}

.dot2 {
  animation-delay: 0.2s;
}

.dot3 {
  animation-delay: 0.4s;
}

@keyframes wave {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.4;
  }
  30% {
    transform: translateY(-2px);
    opacity: 1;
  }
}

.sync-status {
  background: rgba(255, 140, 0, 0.15);
  color: #FF8C00;
  padding: 4px 8px;
  border-radius: 12px;
  font-size: 12px;
  font-weight: 500;
}

/* 达标后（橙色背景）同步状态改为灰色，简洁现代 */
.step-card.achieved .sync-status {
  color: #333333;
  background: rgba(51, 51, 51, 0.15);
}

