page {
  background: #fff;
}

.container {
  margin: 0;
  padding: 40rpx;
  background: #fff;
  min-height: 100vh;
  box-sizing: border-box;
  position: relative;
}

.header {
  position: absolute;
  top: 40rpx;
  left: 40rpx;
  width: calc(100% - 80rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.logo-container {
  width: 100px;
  height: 100px;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.title {
  font-size: 48rpx;
  font-weight: 500;
  color: #000;
  line-height: 1.4;
  text-align: center;
}

.logo {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  overflow: hidden;
}

.form-container {
  position: absolute;
  top: 600rpx;
  left: 40rpx;
  width: calc(100% - 80rpx);
  display: flex;
  flex-direction: column;
}

.form-item {
  margin-bottom: 40rpx;
}

.input {
  width: 100%;
  height: 100rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 0 30rpx;
  font-size: 32rpx;
  box-sizing: border-box;
  border: 2rpx solid #E5E7EB;
}

.input-placeholder {
  color: #999;
  font-size: 32rpx;
}

.login-btn {
  width: 100%;
  height: 100rpx;
  background: #fe2d55;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 600;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 60rpx;
}

.privacy-policy {
  width: 100%;
  font-size: 24rpx;
  color: #666;
  padding: 0 20rpx;
  display: flex;
  justify-content: center;
  margin-top: 40rpx;
}

.policy-label {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  line-height: 1.6;
}

checkbox .wx-checkbox-input {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #D1D5DB;
  margin-right: 12rpx;
}

checkbox .wx-checkbox-input.wx-checkbox-input-checked {
  background: #fe2d55 !important;
  border-color: #fe2d55 !important;
}

checkbox .wx-checkbox-input.wx-checkbox-input-checked::before {
  color: #fff !important;
}

.policy-text {
  color: #666;
  margin-right: 8rpx;
}

.policy-link {
  color: #576B95;
  margin-right: 8rpx;
  text-decoration: underline;
  cursor: pointer;
} 