<view class="export-container">
  <view class="header">
    <text class="title">数据导出</text>
    <text class="subtitle">选择要导出的年月</text>
  </view>

  <view class="form-container">
    <!-- 年份选择 -->
    <view class="form-item">
      <text class="label">选择年份</text>
      <picker 
        class="picker" 
        mode="selector" 
        range="{{years}}" 
        range-key="label"
        value="{{selectedYearIndex}}"
        bindchange="onYearChange">
        <view class="picker-text">
          {{selectedYear}}年
          <text class="arrow">></text>
        </view>
      </picker>
    </view>

    <!-- 月份选择 -->
    <view class="form-item">
      <text class="label">选择月份</text>
      <picker 
        class="picker" 
        mode="selector" 
        range="{{months}}" 
        range-key="label"
        value="{{selectedMonthIndex}}"
        bindchange="onMonthChange">
        <view class="picker-text">
          {{selectedMonth}}月
          <text class="arrow">></text>
        </view>
      </picker>
    </view>

    <!-- 导出说明 -->
    <view class="export-info">
      <view class="info-item">
        <text class="info-label">导出内容：</text>
        <text class="info-text">所有用户步数统计报表</text>
      </view>
      <view class="info-item">
        <text class="info-label">包含字段：</text>
        <text class="info-text">学院、姓名、工号、每日步数、总步数、达标天数、是否达标</text>
      </view>
      <view class="info-item">
        <text class="info-label">达标条件：</text>
        <text class="info-text">步数≥7000且达标天数≥22天</text>
      </view>
      <view class="info-item">
        <text class="info-label">导出方式：</text>
        <text class="info-text">生成下载链接</text>
      </view>
    </view>

    <!-- 导出按钮 -->
    <button 
      class="export-btn {{isExporting ? 'disabled' : ''}}" 
      bindtap="onExport"
      disabled="{{isExporting}}">
      {{isExporting ? '导出中...' : '开始导出'}}
    </button>
  </view>
</view>
