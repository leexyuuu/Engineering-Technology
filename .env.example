# ══════════ LLM 供应商配置（问答生成，供应商可替换）══════════
# mock              = 离线冒烟测试，不联网，无需 API Key（默认）
# openai_compatible = 任意 OpenAI 兼容端点（DeepSeek / Qwen / 智谱 / OpenAI 等）
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# ══════════ Embedding 供应商配置（向量化，供应商可替换）══════════
# local_hash        = 离线验证用哈希词袋嵌入（无语义，仅保证管线可跑，默认）
# openai_compatible = 真实嵌入接口（生产必须切换）
EMBEDDING_PROVIDER=local_hash
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-xxxx
EMBEDDING_MODEL=text-embedding-3-small

# ══════════ JWT 鉴权（阶段3）══════════
# 生产环境必须改为强随机密钥
JWT_SECRET=dev-secret-生产环境务必修改
JWT_EXPIRE_HOURS=24

# ══════════ 检索与会话 ══════════
CHUNK_SIZE=500
TOP_K=3
HISTORY_ROUNDS=6

# ══════════ 限流（每分钟每 IP 请求上限，上线前替换为 Redis）══════════
RATE_LIMIT_PER_MINUTE=20
